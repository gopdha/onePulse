# Copy this file to .env and fill in real values. .env is gitignored;
# never commit real values. See scripts/run_pipeline.py's module
# docstring and CLAUDE.md's Phase 0 tracker for why ONEPULSE_ADO_PAT
# exists at all — it's a time-boxed exception to convention #4 (no
# static credentials), not the long-term pattern.

# Real Azure DevOps Personal Access Token, RAW (not base64-encoded —
# scripts/run_pipeline.py encodes it in code). Scope: Work Items (Read)
# only. Create at https://dev.azure.com/<org>/_usersSettings/tokens.
# Revoke it there when you're done using it; don't let it just expire.
ONEPULSE_ADO_PAT=

# Azure DevOps organization and project to investigate against.
ONEPULSE_ADO_ORG=gopdha
ONEPULSE_ADO_PROJECT=singleSlide

# Foundry project endpoint and the deployment name every agent uses.
ONEPULSE_FOUNDRY_PROJECT_ENDPOINT=https://onepulse-resource.services.ai.azure.com/api/projects/onepulse
ONEPULSE_FOUNDRY_DEPLOYMENT_NAME=onePulse-gpt-5-mini

# Path to the team-lead status deck Status Update Analysis (FR-2) reads.
ONEPULSE_STATUS_DECK_PATH=sample_status_deck.pptx

# Arize AX ingestion (dual-export observability, Phase 0/Task 10). This
# is the ingestion key/space pair, not a Developer Access GraphQL key —
# see CLAUDE.md's Observability Scope for the distinction.
ONEPULSE_ARIZE_SPACE_ID=
ONEPULSE_ARIZE_API_KEY=

# Postgres role to connect as (Phase 2). app_role_local_dev for local
# development against onepulse-pg-dev; app_role is what the deployed
# workload identity uses in every real environment — never set this to
# app_role locally, per onepulse_common/db.py's own docstring.
ONEPULSE_PG_ROLE=app_role_local_dev
