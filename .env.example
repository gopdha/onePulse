# Copy this file to .env and fill in real values. .env is gitignored;
# never commit real values. See scripts/run_pipeline.py's module
# docstring and CLAUDE.md's Phase 0 tracker for why ONEPULSE_ADO_PAT
# exists at all — it's a time-boxed exception to convention #4 (no
# static credentials), not the long-term pattern.

# Real Azure DevOps Personal Access Token, RAW (not base64-encoded —
# scripts/run_pipeline.py encodes it in code). Scope: Work Items (Read)
# only. Create at https://dev.azure.com/<org>/_usersSettings/tokens.
# Revoke it there when you're done using it; don't let it just expire.
ONEPULSE_ADO_PAT=

# Azure DevOps organization and project to investigate against.
ONEPULSE_ADO_ORG=gopdha
ONEPULSE_ADO_PROJECT=singleSlide

# Foundry project endpoint and the deployment name every agent uses.
ONEPULSE_FOUNDRY_PROJECT_ENDPOINT=https://onepulse-resource.services.ai.azure.com/api/projects/onepulse
ONEPULSE_FOUNDRY_DEPLOYMENT_NAME=onePulse-gpt-5-mini

# Path to the team-lead status deck Status Update Analysis (FR-2) reads.
ONEPULSE_STATUS_DECK_PATH=sample_status_deck.pptx

# Arize AX ingestion (dual-export observability, Phase 0/Task 10). This
# is the ingestion key/space pair, not a Developer Access GraphQL key —
# see CLAUDE.md's Observability Scope for the distinction.
ONEPULSE_ARIZE_SPACE_ID=
ONEPULSE_ARIZE_API_KEY=

# Postgres role to connect as (Phase 2). app_role_local_dev for local
# development against onepulse-pg-dev; app_role is what the deployed
# workload identity uses in every real environment — never set this to
# app_role locally, per onepulse_common/db.py's own docstring.
ONEPULSE_PG_ROLE=app_role_local_dev

# Migration Plan Phase 2 (BFF/core API split, ADR-017). Not secrets —
# the App ID and identifier URI are public identifiers, not credentials
# (the actual trust boundary is the signed JWT itself, validated by the
# core API on every request). Real values from this project's own
# `onepulse-core-api` App Registration (az ad app create).
ONEPULSE_CORE_API_APP_ID=51366de2-c856-448f-af25-e76a2051863c
ONEPULSE_CORE_API_IDENTIFIER_URI=api://51366de2-c856-448f-af25-e76a2051863c
ONEPULSE_ENTRA_TENANT_ID=6157b3f3-9398-4e45-9ac2-82a1f347edd7

# No real reviewer authentication until Phase 8 — the BFF forwards this
# stubbed Entra object ID on every request; the core API resolves it
# against the same real actors.entra_object_id row every other
# local-dev entry point already uses (Task 15/24).
ONEPULSE_STUB_ENTRA_OBJECT_ID=local-dev-standin-reviewer

# Where each local service listens / is reached.
ONEPULSE_CORE_API_BASE_URL=http://127.0.0.1:8000
ONEPULSE_BFF_BASE_URL=http://127.0.0.1:8100
# Migration Plan Phase 4 (ADR-019/020): the Investigation service's own
# real HTTP route (GET /internal/investigations/{cycleId}) — the ONLY
# way the Reporting service ever fetches real findings; it never
# connects to the investigation schema directly.
ONEPULSE_INVESTIGATION_BASE_URL=http://127.0.0.1:8200

# Migration Plan Phase 4: the Postgres role the Investigation service
# connects as — holds grants on the `investigation` schema only, none on
# `public` (see scripts/investigation_migrations/0001_initial_schema.sql
# and tests/test_investigation_schema_isolation.py). Never set this to
# app_role/app_role_local_dev — that would defeat the schema boundary.
ONEPULSE_INVESTIGATION_PG_ROLE=investigation_role_local_dev

# Real Application Insights connection string (az monitor app-insights
# component show --app onepulse-observability --resource-group
# onepulse-gr --query connectionString -o tsv). The BFF reads this
# directly rather than via Foundry's telemetry API (every other real
# entry point does that instead) — the BFF must not touch Foundry at
# all, per its own "no data stores" boundary (ADR-017).
ONEPULSE_APPINSIGHTS_CONNECTION_STRING=
